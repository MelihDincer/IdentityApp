@model EditViewModel

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<style>
    .user-edit-page {
        max-width: 1180px;
        margin: 0 auto;
        color: #111827;
    }

    .user-edit-page * {
        box-sizing: border-box;
    }

    .user-edit-page .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        color: #6b7280;
        font-size: .9rem;
        text-decoration: none;
        transition: color .2s;
    }

    .user-edit-page .back-link:hover {
        color: #111827;
    }

    .user-edit-page .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .user-edit-page .page-title {
        margin: 0 0 6px;
        font-size: 1.7rem;
        font-weight: 700;
        letter-spacing: -.03em;
    }

    .user-edit-page .page-description {
        margin: 0;
        color: #6b7280;
        font-size: .92rem;
        line-height: 1.6;
    }

    .user-edit-page .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        background: #fff;
        color: #64748b;
        font-size: .78rem;
        white-space: nowrap;
    }

    .user-edit-page .edit-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 24px;
        align-items: start;
    }

    .user-edit-page .form-card,
    .user-edit-page .info-card {
        overflow: hidden;
        margin-bottom: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 20px rgba(15, 23, 42, .04);
    }

    .user-edit-page .card-header-custom {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 24px;
    border-bottom: 1px solid #eef0f3;
}

    .user-edit-page .section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 11px;
        background: #f1f5f9;
        color: #475569;
        font-size: 1.1rem;
    }

    .user-edit-page .card-title-custom {
        margin: 0;
        font-size: 1rem;
        font-weight: 650;
    }

    .user-edit-page .card-description {
        margin-top: 4px;
        color: #6b7280;
        font-size: .8rem;
        line-height: 1.5;
    }

    .user-edit-page .card-body-custom {
        padding: 24px;
    }

    .user-edit-page .field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .user-edit-page .field-full {
        grid-column: 1 / -1;
    }

    .user-edit-page .form-label-custom {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-size: .86rem;
        font-weight: 600;
    }

    .user-edit-page .required {
        color: #dc2626;
    }

    .user-edit-page .form-control-custom {
        display: block;
        width: 100%;
        height: 46px;
        padding: 0 14px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        outline: none;
        background: #fff;
        color: #111827;
        font: inherit;
        font-size: .9rem;
        transition: border-color .2s, box-shadow .2s;
    }

    .user-edit-page .form-control-custom::placeholder {
        color: #9ca3af;
    }

    .user-edit-page .form-control-custom:focus {
        border-color: #94a3b8;
        box-shadow: 0 0 0 4px rgba(148, 163, 184, .12);
    }

    .user-edit-page .form-help {
        margin-top: 7px;
        color: #6b7280;
        font-size: .75rem;
        line-height: 1.6;
    }

    .user-edit-page .verification-list {
        display: grid;
        gap: 12px;
    }

    .user-edit-page .custom-check {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        cursor: pointer;
        transition: background .2s, border-color .2s;
    }

    .user-edit-page .custom-check:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
    }

    .user-edit-page .custom-check input[type="checkbox"] {
        width: 17px;
        height: 17px;
        margin-top: 3px;
        flex-shrink: 0;
        accent-color: #111827;
        cursor: pointer;
    }

    .user-edit-page .custom-check-title {
        display: block;
        color: #374151;
        font-size: .86rem;
        font-weight: 600;
    }

    .user-edit-page .custom-check-description {
        display: block;
        margin-top: 4px;
        color: #6b7280;
        font-size: .76rem;
        line-height: 1.6;
    }

    .user-edit-page .info-notice {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 18px;
        padding: 13px 14px;
        border-radius: 10px;
        background: #f8fafc;
        color: #64748b;
        font-size: .77rem;
        line-height: 1.7;
    }

    .user-edit-page .form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 24px;
        border-top: 1px solid #eef0f3;
        background: #fafafa;
    }

    .user-edit-page .actions-note {
        color: #6b7280;
        font-size: .75rem;
    }

    .user-edit-page .action-buttons {
        display: flex;
        gap: 10px;
    }

    .user-edit-page .btn-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 18px;
        border-radius: 9px;
        font: inherit;
        font-size: .84rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background .2s, color .2s;
    }

    .user-edit-page .btn-cancel {
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #6b7280;
    }

    .user-edit-page .btn-cancel:hover {
        background: #f1f5f9;
        color: #111827;
    }

    .user-edit-page .btn-save {
        border: 1px solid #111827;
        background: #111827;
        color: #fff;
    }

    .user-edit-page .btn-save:hover {
        border-color: #374151;
        background: #374151;
    }

    .user-edit-page .edit-sidebar {
        position: sticky;
        top: 20px;
        min-width: 0;
    }

    .user-edit-page .profile-body {
        padding: 24px;
    }

    .user-edit-page .profile-heading {
        margin-bottom: 20px;
        color: #64748b;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .08em;
    }

    .user-edit-page .profile-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        margin-bottom: 16px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #f1f5f9;
        color: #475569;
        font-size: 1.6rem;
    }

    .user-edit-page .profile-name {
        margin: 0 0 6px;
        font-size: 1.1rem;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .user-edit-page .profile-email {
        margin: 0;
        color: #6b7280;
        font-size: .82rem;
        overflow-wrap: anywhere;
    }

    .user-edit-page .profile-details {
        margin: 22px 0 0;
        padding-top: 20px;
        border-top: 1px solid #eef0f3;
    }

    .user-edit-page .profile-details dt {
        margin-bottom: 7px;
        color: #6b7280;
        font-size: .75rem;
        font-weight: 500;
    }

    .user-edit-page .profile-details dd {
        margin: 0 0 18px;
        color: #374151;
        font-size: .78rem;
        overflow-wrap: anywhere;
    }

    .user-edit-page .profile-details dd:last-child {
        margin-bottom: 0;
    }

    .user-edit-page .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 6px;
        background: #f1f5f9;
        color: #64748b;
        font-size: .73rem;
    }

    .user-edit-page .status-badge.verified {
        background: #ecfdf5;
        color: #047857;
    }

    .user-edit-page .sidebar-footer {
        padding: 16px 24px;
        border-top: 1px solid #eef0f3;
        background: #fafafa;
        color: #6b7280;
        font-size: .75rem;
        line-height: 1.7;
    }

    .user-edit-page .validation-summary-valid,
    .user-edit-page .field-validation-valid {
        display: none;
    }

    .user-edit-page .validation-summary-errors {
        margin-bottom: 20px;
        padding: 14px 16px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: .84rem;
    }

    .user-edit-page .validation-summary-errors ul {
        margin: 0;
        padding-left: 18px;
    }

    .user-edit-page .field-validation-error {
        display: block;
        margin-top: 7px;
        color: #dc2626;
        font-size: .76rem;
    }

    .user-edit-page .input-validation-error {
        border-color: #fca5a5;
        background: #fffafa;
    }

    .user-edit-page a:focus-visible,
    .user-edit-page button:focus-visible,
    .user-edit-page input[type="checkbox"]:focus-visible {
        outline: 3px solid #64748b;
        outline-offset: 3px;
    }

    @@media (max-width: 992px) {
        .user-edit-page .edit-layout {
            grid-template-columns: 1fr;
        }

        .user-edit-page .edit-sidebar {
            position: static;
        }
    }

    @@media (max-width: 576px) {
        .user-edit-page .header-badge {
            display: none;
        }

        .user-edit-page .field-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .user-edit-page .card-header-custom,
        .user-edit-page .card-body-custom {
            padding: 18px;
        }

        .user-edit-page .form-actions {
            flex-direction: column;
            align-items: stretch;
            padding: 18px;
        }

        .user-edit-page .action-buttons {
            flex-direction: column-reverse;
        }

        .user-edit-page .btn-custom {
            width: 100%;
        }
    }

    /* =========================
       ROLE SELECT
    ========================== */

    .role-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .role-option {
        position: relative;
    }

    .role-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .role-option label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 13px;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        color: #6b7280;
        font-size: .82rem;
        cursor: pointer;
        transition: .2s ease;
        user-select: none;
    }

    .role-option label:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
    }

    .role-option input:checked + label {
        background: #f1f5f9;
        border-color: #94a3b8;
        color: #111827;
        font-weight: 600;
    }

     .user-edit-page .password-heading {
    flex: 1;
    min-width: 0;
}

.user-edit-page .password-switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #475569;
    font-size: .78rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
}

.user-edit-page .password-switch input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    width: 40px;
    height: 23px;
    margin: 0;
    flex-shrink: 0;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: #e2e8f0;
    cursor: pointer;
    transition: background .2s, border-color .2s;
}

.user-edit-page .password-switch input[type="checkbox"]::before {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, .15);
    transition: transform .2s;
}

.user-edit-page .password-switch input[type="checkbox"]:checked {
    border-color: #111827;
    background: #111827;
}

.user-edit-page .password-switch input[type="checkbox"]:checked::before {
    transform: translateX(17px);
}

.user-edit-page .password-fields {
    min-width: 0;
    margin: 0;
    border: 0;
}

.user-edit-page .password-fields[hidden] {
    display: none;
}

.user-edit-page .password-input-wrapper {
    position: relative;
}

.user-edit-page .password-input-wrapper .form-control-custom {
    padding-right: 48px;
}

.user-edit-page .password-eye {
    position: absolute;
    top: 50%;
    right: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    transform: translateY(-50%);
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #9ca3af;
    cursor: pointer;
}

.user-edit-page .password-eye:hover {
    background: #f1f5f9;
    color: #374151;
}

@@media (max-width: 576px) {
    .user-edit-page .password-card-header {
        flex-wrap: wrap;
    }

    .user-edit-page .password-switch {
        width: 100%;
        justify-content: space-between;
        margin-top: 6px;
    }
}   
</style>

<div class="container-fluid py-4">
    <div class="user-edit-page">

        <a asp-controller="Users"
           asp-action="Index"
           class="back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Kullanıcılara Dön
        </a>

        <div class="page-header">
            <div>
                <h1 class="page-title">Kullanıcı Düzenle</h1>
                <p class="page-description">
                    Kullanıcının hesap ve iletişim bilgilerini güncelleyin.
                </p>
            </div>

            <span class="header-badge">
                <i class="bi bi-person-gear" aria-hidden="true"></i>
                Kullanıcı Yönetimi
            </span>
        </div>

        <div class="edit-layout">

            <div>
                <form asp-controller="Users"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post"
                      asp-antiforgery="true">

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="All" role="alert"></div>

                    <!-- HESAP BİLGİLERİ -->
                    <div class="form-card">
                        <div class="card-header-custom">
                            <div class="section-icon">
                                <i class="bi bi-person" aria-hidden="true"></i>
                            </div>

                            <div>
                                <h2 class="card-title-custom">
                                    Hesap Bilgileri
                                </h2>
                                <div class="card-description">
                                    Kullanıcının temel bilgilerini düzenleyin.
                                </div>
                            </div>
                        </div>

                        <div class="card-body-custom">
                            <div class="field-grid">

                                <div class="field-full">
                                    <label asp-for="FullName"
                                           class="form-label-custom">
                                        Ad Soyad
                                        <span class="required">*</span>
                                    </label>

                                    <input asp-for="FullName"
                                           class="form-control-custom"
                                           placeholder="Örn. Ahmet Yılmaz"
                                           autocomplete="name" />

                                    <span asp-validation-for="FullName"></span>
                                </div>

                                <div>
                                    <label asp-for="Email"
                                           class="form-label-custom">
                                        E-posta Adresi
                                        <span class="required">*</span>
                                    </label>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control-custom"
                                           placeholder="ornek@sirket.com"
                                           autocomplete="email" />

                                    <span asp-validation-for="Email"></span>
                                </div>

                                <div>
                                    <label asp-for="PhoneNumber"
                                           class="form-label-custom">
                                        Telefon Numarası
                                    </label>

                                    <input asp-for="PhoneNumber"
                                           type="tel"
                                           class="form-control-custom"
                                           placeholder="+90 5XX XXX XX XX"
                                           autocomplete="tel" />

                                    <span asp-validation-for="PhoneNumber"></span>

                                    <div class="form-help">
                                        Telefon numarası isteğe bağlıdır.
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="form-card">
                    <div class="card-header-custom">
    <div class="section-icon">
        <i class="bi bi-person-badge" aria-hidden="true"></i>
    </div>

    <div>
        <h2 class="card-title-custom">Roller</h2>

        <div class="card-description">
            Kullanıcının sistem içerisindeki yetkilerini belirleyin.
        </div>
    </div>
</div>

                    <div class="card-body-custom">
                        <div class="role-list">
                            <div class="role-option">
                                <input type="checkbox"
                                       id="roleUser"
                                       checked />
                                <label for="roleUser">
                                    <i class="bi bi-person"></i>
                                    User
                                </label>
                            </div>

                            <div class="role-option">
                                <input type="checkbox"
                                       id="roleAdmin" />
                                <label for="roleAdmin">
                                    <i class="bi bi-shield"></i>
                                    Admin
                                </label>
                            </div>

                            <div class="role-option">
                                <input type="checkbox"
                                       id="roleModerator" />
                                <label for="roleModerator">
                                    <i class="bi bi-person-gear"></i>
                                    Moderator
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

<!-- PAROLA -->
<div class="form-card">
    <div class="card-header-custom password-card-header">
        <div class="section-icon">
            <i class="bi bi-lock" aria-hidden="true"></i>
        </div>

        <div class="password-heading">
            <h2 class="card-title-custom">Parola</h2>

            <div class="card-description">
                İsteğe bağlı olarak yeni bir parola belirleyin.
            </div>
        </div>

        <label class="password-switch">
            <span>Parolayı değiştir</span>

            <input asp-for="ChangePassword"
                   id="changePasswordToggle"
                   aria-controls="passwordFields"
                   aria-expanded="@(Model.ChangePassword ? "true" : "false")" />
        </label>
    </div>

    <fieldset id="passwordFields"
              class="card-body-custom password-fields"
              hidden="@(!Model.ChangePassword)"
              disabled="@(!Model.ChangePassword)"
              aria-label="Yeni parola bilgileri">

        <div class="field-grid">
            <div>
                <label asp-for="NewPassword"
                       class="form-label-custom">
                    Yeni Parola
                    <span class="required">*</span>
                </label>

                <div class="password-input-wrapper">
                    <input asp-for="NewPassword"
                           type="password"
                           id="editNewPassword"
                           class="form-control-custom"
                           placeholder="Yeni parola girin"
                           autocomplete="new-password"
                           aria-describedby="newPasswordError" />

                    <button type="button"
                            class="password-eye"
                            data-password-target="editNewPassword"
                            aria-label="Parolayı göster"
                            aria-pressed="false">

                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>

                <span asp-validation-for="NewPassword"
                      id="newPasswordError"></span>
            </div>

            <div>
                <label asp-for="ConfirmNewPassword"
                       class="form-label-custom">
                    Yeni Parola Tekrar
                    <span class="required">*</span>
                </label>

                <div class="password-input-wrapper">
                    <input asp-for="ConfirmNewPassword"
                           type="password"
                           id="editConfirmNewPassword"
                           class="form-control-custom"
                           placeholder="Yeni parolayı tekrar girin"
                           autocomplete="new-password"
                           aria-describedby="confirmNewPasswordError" />

                    <button type="button"
                            class="password-eye"
                            data-password-target="editConfirmNewPassword"
                            aria-label="Parolayı göster"
                            aria-pressed="false">

                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>

                <span asp-validation-for="ConfirmNewPassword"
                      id="confirmNewPasswordError"></span>
            </div>
        </div>

        <div class="info-notice">
            <i class="bi bi-info-circle" aria-hidden="true"></i>

            <span>
                Yeni parola, Değişiklikleri Kaydet butonuna
                bastığınızda uygulanır.
            </span>
        </div>
    </fieldset>
</div>
                    <!-- DOĞRULAMA BİLGİLERİ -->
                    <div class="form-card">
                        <div class="card-header-custom">
                            <div class="section-icon">
                                <i class="bi bi-shield-check"
                                   aria-hidden="true"></i>
                            </div>

                            <div>
                                <h2 class="card-title-custom">
                                    Doğrulama Bilgileri
                                </h2>
                                <div class="card-description">
                                    E-posta ve telefon doğrulama durumunu yönetin.
                                </div>
                            </div>
                        </div>

                        <div class="card-body-custom">
                            <div class="verification-list">

                                <label class="custom-check">
                                    <input asp-for="EmailConfirmed" />

                                    <span>
                                        <span class="custom-check-title">
                                            E-posta doğrulandı
                                        </span>
                                        <span class="custom-check-description">
                                            Kullanıcının e-posta adresi
                                            doğrulanmış olarak kaydedilir.
                                        </span>
                                    </span>
                                </label>

                                <label class="custom-check">
                                    <input asp-for="PhoneNumberConfirmed" />

                                    <span>
                                        <span class="custom-check-title">
                                            Telefon doğrulandı
                                        </span>
                                        <span class="custom-check-description">
                                            Kullanıcının telefon numarası doğrulanmış olarak kaydedilir.
                                        </span>
                                    </span>
                                </label>

                            </div>

                            <div class="info-notice">
                                <i class="bi bi-info-circle"
                                   aria-hidden="true"></i>
                                <span>
                                    E-posta veya telefon bilgisi değiştiyse nyeni bilginin doğruluğunu kontrol ederek doğrulama durumunu güncelleyin.
                                </span>
                            </div>
                        </div>

                        <!-- BUTONLAR -->
                        <div class="form-actions">
                            <span class="actions-note">
                                <span class="required">*</span>
                                Zorunlu alanlar
                            </span>

                            <div class="action-buttons">
                                <a asp-controller="Users"
                                   asp-action="Index"
                                   class="btn-custom btn-cancel">
                                    Vazgeç
                                </a>

                                <button type="submit"
                                        class="btn-custom btn-save">
                                    <i class="bi bi-check2"
                                       aria-hidden="true"></i>
                                    Değişiklikleri Kaydet
                                </button>
                            </div>
                        </div>
                    </div>

                </form>
            </div>

            <!-- KULLANICI ÖZETİ -->
            <aside class="edit-sidebar">
                <div class="info-card">
                    <div class="profile-body">

                        <div class="profile-heading">
                            DÜZENLENEN KULLANICI
                        </div>

                        <div class="profile-avatar">
                            <i class="bi bi-person" aria-hidden="true"></i>
                        </div>

                        <h2 class="profile-name">
                            @(string.IsNullOrWhiteSpace(Model.FullName)
                                ? "Kullanıcı"
                                : Model.FullName)
                        </h2>

                        <p class="profile-email">@Model.Email</p>

                        <dl class="profile-details">
                            <dt>Kullanıcı ID</dt>
                            <dd>@Model.Id</dd>

                            <dt>E-posta Doğrulaması</dt>
                            <dd>
                                @if (Model.EmailConfirmed)
                                {
                                    <span class="status-badge verified">
                                        <i class="bi bi-check-circle"
                                           aria-hidden="true"></i>
                                        Doğrulandı
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge">
                                        <i class="bi bi-clock"
                                           aria-hidden="true"></i>
                                        Doğrulanmadı
                                    </span>
                                }
                            </dd>

                            <dt>Telefon Doğrulaması</dt>
                            <dd>
                                @if (Model.PhoneNumberConfirmed)
                                {
                                    <span class="status-badge verified">
                                        <i class="bi bi-check-circle"
                                           aria-hidden="true"></i>
                                        Doğrulandı
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge">
                                        <i class="bi bi-clock"
                                           aria-hidden="true"></i>
                                        Doğrulanmadı
                                    </span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <div class="sidebar-footer">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        Bu özet, sayfa açıldığındaki bilgileri gösterir. Düzenlemelerinizi kaydetmek için<strong> Değişiklikleri Kaydet </strong>butonunu kullanın.
                    </div>
                </div>
            </aside>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const toggle = document.getElementById("changePasswordToggle");
            const fields = document.getElementById("passwordFields");
            const password = document.getElementById("editNewPassword");
            const confirmation =
                document.getElementById("editConfirmNewPassword");

            const eyeButtons =
                fields.querySelectorAll("[data-password-target]");

            function syncPasswordSection(clearValues = false) {
                const enabled = toggle.checked;

                fields.hidden = !enabled;
                fields.disabled = !enabled;

                toggle.setAttribute("aria-expanded", String(enabled));

                password.required = enabled;
                confirmation.required = enabled;

                if (!enabled && clearValues) {
                    password.value = "";
                    confirmation.value = "";
                    confirmation.setCustomValidity("");

                    eyeButtons.forEach(button => {
                        const input = document.getElementById(
                            button.dataset.passwordTarget
                        );

                        input.type = "password";

                        button.setAttribute("aria-pressed", "false");
                        button.setAttribute("aria-label", "Parolayı göster");

                        const icon = button.querySelector("i");

                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");
                    });
                }
            }

            function checkPasswordMatch() {
                const mismatch =
                    toggle.checked &&
                    confirmation.value !== "" &&
                    password.value !== confirmation.value;

                confirmation.setCustomValidity(
                    mismatch ? "Parolalar birbiriyle eşleşmiyor." : ""
                );
            }

            toggle.addEventListener("change", () => {
                syncPasswordSection(true);

                if (toggle.checked) {
                    password.focus();
                }
            });

            password.addEventListener("input", checkPasswordMatch);
            confirmation.addEventListener("input", checkPasswordMatch);

            eyeButtons.forEach(button => {
                button.addEventListener("click", () => {
                    const input = document.getElementById(
                        button.dataset.passwordTarget
                    );

                    const showPassword = input.type === "password";

                    input.type = showPassword ? "text" : "password";

                    button.setAttribute(
                        "aria-pressed",
                        String(showPassword)
                    );

                    button.setAttribute(
                        "aria-label",
                        showPassword ? "Parolayı gizle" : "Parolayı göster"
                    );

                    const icon = button.querySelector("i");

                    icon.classList.toggle("bi-eye", !showPassword);
                    icon.classList.toggle("bi-eye-slash", showPassword);
                });
            });

            syncPasswordSection();
        })();
    </script>
}