@model IEnumerable<AppUser>

<div class="container-fluid py-4"> <div class="users-page">

    @if (TempData["WarningMessage"] is string warningMessage)
{
    <div class="alert alert-warning d-flex align-items-center gap-2"
         role="alert"
         style="border-radius: 12px; font-size: .88rem;">

        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>

        <span>@warningMessage</span>
    </div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success d-flex align-items-center gap-2"
         role="alert"
         style="border-radius: 12px; font-size: .88rem;">

        <i class="bi bi-check-circle" aria-hidden="true"></i>
        <span>@successMessage</span>
    </div>
}

    <!-- Header -->

<div class="page-header">
<div>
    <h1 class="page-title">
        Kullanıcılar
    </h1>

    <p class="page-description">
        Sistemde kayıtlı kullanıcıları görüntüleyin ve yönetin.
    </p>
</div>

<!-- Yeni Kullanıcı -->
<a href="@Url.Action("Create", "Users")"
   class="add-user-btn">
    <i class="bi bi-plus-lg"></i>
    <span>Yeni Kullanıcı</span>
</a>

</div>


    <!-- User Table -->
    <div class="users-card">

        <div class="users-toolbar">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text"
       id="userSearch"
       class="form-control"
       placeholder="Kullanıcı, e-posta, telefon veya ID ara..."
       autocomplete="off">
            </div>

            <div class="user-count">
                Toplam <strong id="userCount">@Model.Count()</strong> kullanıcı
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table class="users-table" id="usersTable">
                <thead>
                    <tr>
                        <th>Kullanıcı</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>E-posta Durumu</th>
                        <th>Güvenlik</th>
                        <th>Hesap</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                @if (Model.Any())
                {
                    foreach (var user in Model)
                    {
                        var displayName = string.IsNullOrWhiteSpace(user.FullName)
                            ? "Bilinmeyen Kullanıcı"
                            : user.FullName;

                        var initial = displayName.Substring(0, 1).ToUpper();

                        var isLocked = user.LockoutEnd.HasValue &&
                                       user.LockoutEnd.Value > DateTimeOffset.UtcNow;
                        var searchText = string.Join(" ", new[] { user.FullName, user.Email, user.PhoneNumber, user.Id, user.EmailConfirmed ? "doğrulandı aktif" : "doğrulanmadı", user.TwoFactorEnabled ? "2fa aktif güvenli" : "2fa kapalı", isLocked ? "kilitli" : "aktif" }.Where(x => !string.IsNullOrWhiteSpace(x)));

                        <tr class="user-row" data-search="@searchText">
                            <!-- User -->
                            <td>
                                <div class="user-info">
                                    <div class="avatar">
                                        @initial
                                    </div>
                                    <div>
                                        <div class="username">
                                            @displayName
                                        </div>
                                        <div class="user-id"
                                             title="@user.Id">
                                            @user.Id
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Email -->
                            <td>
                                <div class="email">
                                    @(string.IsNullOrWhiteSpace(user.Email)
                                        ? "-"
                                        : user.Email)
                                </div>
                            </td>

                            <!-- Phone -->
                            <td>
                                <div class="phone">
                                    @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                        ? "-"
                                        : user.PhoneNumber)
                                </div>
                            </td>

                            <!-- Email Confirmed -->
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <span class="status-badge status-success">
                                        Doğrulandı
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-warning">
                                        Doğrulanmadı
                                    </span>
                                }
                            </td>

                            <!-- Security -->
                            <td>
                                @if (user.TwoFactorEnabled)
                                {
                                    <span class="status-badge status-success">
                                        2FA Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-neutral">
                                        2FA Kapalı
                                    </span>
                                }
                            </td>

                            <!-- Account -->
                            <td>
                                @if (isLocked)
                                {
                                    <span class="status-badge status-danger">
                                        Kilitli
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-success">
                                        Aktif
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="actions">
                                <!-- Detay -->
                                <a href="@Url.Action("Edit", "Users", new { id = user.Id })"
                                   class="action-btn"
                                   title="Kullanıcı Detayları">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <!-- Sil -->
                                <button type="button"
                                        class="action-btn delete-btn"
                                        title="Kullanıcıyı Sil"
                                        data-user-id="@user.Id"
                                        data-user-name="@displayName">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <i class="bi bi-people"></i>
                                </div>
                                <strong>Henüz kullanıcı bulunmuyor.</strong>
                                <div class="mt-1">
                                    Sistemde kayıtlı kullanıcı bulunamadı.
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

</div>
<!-- Delete Modal -->
<div class="modal fade"
     id="deleteUserModal"
     tabindex="-1"
     aria-labelledby="deleteUserModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
        <div class="modal-body p-4">
            <div class="text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="
                        width:56px;
                        height:56px;
                        border-radius:14px;
                        background:#fef2f2;
                        color:#dc2626;
                        font-size:22px;
                     ">
                    <i class="bi bi-trash3"></i>
                </div>
                <h5 class="fw-bold mb-2">
                    Kullanıcı silinsin mi?
                </h5>
                <p class="text-muted mb-1">
                    Bu işlem geri alınamaz.
                </p>
                <div class="fw-semibold text-dark" id="deleteUserName"></div>
            </div>
            <form asp-action="Delete" asp-controller="Users" method="post" id="deleteUserForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteUserId" />
                <div class="d-flex gap-2 mt-4">
                    <button type="button" class="btn btn-light w-50" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger w-50">
                        <i class="bi bi-trash3 me-1"></i>
                        Sil
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            initializeUserSearch();
            initializeDeleteModal();
        });

        // ==================================================
        // 1. KULLANICI ARAMA
        // Kullanıcıları filtreler ve görünen sayıyı günceller.
        // ==================================================
        function initializeUserSearch() {
            const searchInput = document.getElementById("userSearch");
            const countElement = document.getElementById("userCount");
            const rows = document.querySelectorAll("#usersTable .user-row");

            // Aranacak metni her tuşta yeniden hazırlamak yerine
            // sayfa açıldığında bir kez hazırlıyoruz.
            const users = Array.from(rows, function (row) {
                return {
                    row: row,
                    searchText: normalizeSearchText(row.dataset.search)
                };
            });

            function filterUsers() {
                const searchText = normalizeSearchText(searchInput.value);
                let visibleCount = 0;

                users.forEach(function (user) {
                    const isMatch = user.searchText.includes(searchText);

                    user.row.style.display = isMatch ? "" : "none";

                    if (isMatch) {
                        visibleCount++;
                    }
                });

                countElement.textContent = visibleCount;
            }

            searchInput.addEventListener("input", filterUsers);

            // Sayfa açıldığında arama alanında bir değer varsa uygular.
            filterUsers();
        }

        // Türkçe büyük/küçük harf dönüşümünü yapar,
        // baştaki ve sondaki boşlukları temizler.
        function normalizeSearchText(value) {
            return (value || "")
                .toLocaleLowerCase("tr-TR")
                .trim();
        }

        // ==================================================
        // 2. KULLANICI SİLME PENCERESİ
        // Seçilen kullanıcının bilgilerini modal içine aktarır.
        // ==================================================
        function initializeDeleteModal() {
            const modalElement = document.getElementById("deleteUserModal");
            const userIdInput = document.getElementById("deleteUserId");
            const userNameElement = document.getElementById("deleteUserName");
            const deleteButtons =
                document.querySelectorAll("#usersTable .delete-btn");

            const deleteModal = new bootstrap.Modal(modalElement);

            deleteButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    userIdInput.value = button.dataset.userId;
                    userNameElement.textContent = button.dataset.userName;
                    deleteModal.show();
                });
            });
        }
    </script>
}