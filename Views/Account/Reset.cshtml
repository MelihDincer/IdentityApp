@model IdentityApp.ViewModels.ResetPasswordViewModel

@{
    Layout = null;

    var state = ViewData["ResetState"] as string;
    var isSuccess = state == "Success";
    var isInvalid = state == "Invalid";

    ViewData["Title"] = isSuccess
        ? "Parolanız güncellendi"
        : isInvalid
            ? "Bağlantı kullanılamıyor"
            : "Yeni parola belirleyin";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />

    <title>@ViewData["Title"] - IdentityApp</title>

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

    <style>
        .reset-state-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            margin-bottom: 24px;
            border-radius: 18px;
        }

        .reset-state-icon svg {
            width: 32px;
            height: 32px;
        }

        .reset-state-icon--success {
            color: #047857;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
        }

        .reset-state-icon--invalid {
            color: #b45309;
            background: #fffbeb;
            border: 1px solid #fde68a;
        }

        a.reset-action {
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            width: 100%;
            margin-top: 24px;
            text-decoration: none;
        }
    </style>
</head>

<body class="auth-page">
    <main class="auth-shell">

        <div class="auth-brand">
            <span class="auth-brand-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.6"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 3 20 6v6c0 4-5 8-8 9-3-1-8-5-8-9V6l8-3Z" />
                    <path d="m8.5 12 2.5 2.5 4.5-5" />
                </svg>
            </span>

            <span>IdentityApp</span>
        </div>

        <div class="auth-panel">

            <aside class="auth-aside" aria-label="Hesap güvenliği">
                <div>
                    <span class="auth-eyebrow">Hesap güvenliği</span>

                    <h2>Güvenli bir parola.<br />Yeni bir başlangıç.</h2>

                    <p>
                        Hesabınız için başka uygulamalarda kullanmadığınız,
                        güçlü bir parola belirleyin.
                    </p>
                </div>

                <div class="auth-aside-note">
                    Parolanızı ve sıfırlama bağlantınızı kimseyle paylaşmayın.
                </div>
            </aside>

            <section class="auth-content" aria-labelledby="pageTitle">

                @if (isSuccess)
                {
                    <div class="reset-state-icon reset-state-icon--success"
                         aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" />
                            <path d="m8 12 2.5 2.5L16 9" />
                        </svg>
                    </div>

                    <header class="auth-heading">
                        <h1 id="pageTitle">Parolanız güncellendi</h1>
                        <p>
                            Parolanız başarıyla değiştirildi.
                            Yeni parolanızla hesabınıza giriş yapabilirsiniz.
                        </p>
                    </header>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="auth-submit reset-action">
                        Giriş yap
                    </a>
                }
                else if (isInvalid)
                {
                    <div class="reset-state-icon reset-state-icon--invalid"
                         aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v6" />
                            <path d="M12 17h.01" />
                        </svg>
                    </div>

                    <header class="auth-heading">
                        <h1 id="pageTitle">Bağlantı kullanılamıyor</h1>
                        <p>
                            Parola sıfırlama bağlantısı geçersiz, süresi dolmuş
                            veya daha önce kullanılmış olabilir.
                            Devam etmek için yeni bir bağlantı isteyin.
                        </p>
                    </header>

                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="auth-submit reset-action">
                        Yeni bağlantı iste
                    </a>

                    <p class="auth-switch">
                        <a asp-controller="Account" asp-action="Login">
                            Giriş sayfasına dön
                        </a>
                    </p>
                }
                else
                {
                    <header class="auth-heading">
                        <h1 id="pageTitle">Yeni parolanızı belirleyin</h1>
                        <p>
                            Yeni parolanızı aşağıdaki iki alana da yazın.
                        </p>
                    </header>

                    <form asp-controller="Account"
                          asp-action="Reset"
                          method="post"
                          class="auth-form">

                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Code" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="auth-validation"
                             role="alert">
                        </div>

                        <div class="auth-field">
                            <label asp-for="Password" class="auth-label">
                                Yeni parola
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="auth-input"
                                   placeholder="Yeni parolanızı girin"
                                   autocomplete="new-password"
                                   aria-describedby="passwordError"
                                   required />

                            <span asp-validation-for="Password"
                                  id="passwordError"
                                  class="auth-error">
                            </span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="ConfirmPassword" class="auth-label">
                                Yeni parola tekrarı
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="auth-input"
                                   placeholder="Yeni parolanızı tekrar girin"
                                   autocomplete="new-password"
                                   aria-describedby="confirmPasswordError"
                                   required />

                            <span asp-validation-for="ConfirmPassword"
                                  id="confirmPasswordError"
                                  class="auth-error">
                            </span>
                        </div>

                        <button type="submit" class="auth-submit">
                            Parolamı güncelle
                        </button>
                    </form>

                    <p class="auth-switch">
                        <a asp-controller="Account" asp-action="Login">
                            Giriş sayfasına dön
                        </a>
                    </p>
                }

            </section>
        </div>

        <footer class="auth-footer">
            © @DateTime.Now.Year IdentityApp
        </footer>

    </main>
</body>
</html>