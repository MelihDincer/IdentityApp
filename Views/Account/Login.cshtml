@model IdentityApp.ViewModels.LoginViewModel

@{
    Layout = null;

    var successMessage = TempData["SuccessMessage"] as string;
    var warningMessage = TempData["WarningMessage"] as string;
    var infoMessage = TempData["InfoMessage"] as string;

    var showEmailConfirmation =
        TempData["ShowResendConfirmation"] is true ||
        ViewData["ShowEmailConfirmation"] is true;

    var loginTarget = ViewData["LoginSuccessTarget"] as string;
    var loginSucceeded = !string.IsNullOrWhiteSpace(loginTarget);
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Giriş Yap - IdentityApp</title>

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body class="auth-page @(loginSucceeded ? "login-success-open" : "")">

    <main class="auth-shell" inert="@loginSucceeded">

        <div class="auth-brand">
            <span class="auth-brand-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.6"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 3 20 6v6c0 4-5 8-8 9-3-1-8-5-8-9V6l8-3Z" />
                    <path d="m8.5 12 2.5 2.5 4.5-5" />
                </svg>
            </span>

            <span>IdentityApp</span>
        </div>

        <div class="auth-panel">

            <aside class="auth-aside">
                <div>
                    <span class="auth-eyebrow">Hesap erişimi</span>

                    <h2>Tekrar<br />hoş geldiniz.</h2>

                    <p>
                        Hesabınıza giriş yapın, çalışma alanınıza
                        kaldığınız yerden devam edin.
                    </p>
                </div>

                <div class="auth-aside-note">
                    Hesabınız ve çalışma alanınız, tek bir yerde.
                </div>
            </aside>

            <section class="auth-content" aria-labelledby="loginTitle">

                <header class="auth-heading">
                    <h1 id="loginTitle">Giriş yap</h1>
                    <p>Devam etmek için e-posta adresinizi ve parolanızı girin.</p>
                </header>

                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="auth-feedback auth-feedback-success"
                         role="status">
                        <p>@successMessage</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(warningMessage))
                {
                    <div class="auth-feedback auth-feedback-warning"
                         role="alert">
                        <p>@warningMessage</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(infoMessage))
                {
                    <div class="auth-notice" role="status">
                        @infoMessage
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      id="loginForm"
                      class="auth-form">

                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="ModelOnly"
                         class="auth-validation"
                         role="alert">
                    </div>

                    @if (showEmailConfirmation)
                    {
                        <a asp-controller="Account"
                           asp-action="RegisterConfirmation"
                           class="auth-confirm-link">
                            Doğrulama e-postasını yeniden gönder
                        </a>
                    }

                    <div class="auth-field">
                        <label asp-for="Email" class="auth-label">
                            E-posta adresi
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="auth-input"
                               placeholder="ornek@firma.com"
                               autocomplete="username"
                               aria-describedby="emailError"
                               required />

                        <span asp-validation-for="Email"
                              id="emailError"
                              class="auth-error">
                        </span>
                    </div>

                    <div class="auth-field">
                        <label for="Password" class="auth-label">
                            Parola
                        </label>

                        <input id="Password"
                               name="Password"
                               type="password"
                               class="auth-input"
                               placeholder="Parolanızı girin"
                               autocomplete="current-password"
                               aria-describedby="passwordError"
                               required />

                        <span asp-validation-for="Password"
                              id="passwordError"
                              class="auth-error">
                        </span>
                    </div>

                    <label class="auth-checkbox" for="RememberMe">
                        <input asp-for="RememberMe" />
                        <span>Beni hatırla</span>
                    </label>

                    <button type="submit"
                            id="loginButton"
                            class="auth-submit">

                        <span id="loginSpinner"
                              class="login-submit-spinner"
                              aria-hidden="true"
                              hidden>
                        </span>

                        <span id="loginButtonText">Giriş yap</span>
                    </button>
                </form>

                <p class="auth-switch">
                    <a asp-controller="Account" asp-action="ForgotPassword">
                        Parolamı unuttum
                    </a>
                </p>

                <p class="auth-switch">
                    Henüz hesabınız yok mu?
                    <a asp-controller="Account" asp-action="Register">
                        Hesap oluştur
                    </a>
                </p>

            </section>
        </div>

        <footer class="auth-footer">
            © @DateTime.Now.Year IdentityApp
        </footer>
    </main>

    @if (loginSucceeded)
    {
        <div class="login-success-overlay">
            <section id="loginSuccessDialog"
                     class="login-success-card"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="loginSuccessTitle"
                     aria-describedby="loginSuccessDescription"
                     tabindex="-1">

                <div class="login-success-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="3"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="m6 12 4 4 8-8" />
                    </svg>
                </div>

                <h2 id="loginSuccessTitle">Başarıyla giriş yaptınız</h2>

                <p id="loginSuccessDescription">
                    Çalışma alanınıza yönlendiriliyorsunuz.
                </p>

                <div class="login-success-progress" aria-hidden="true">
                    <span></span>
                </div>

                <a id="loginContinueLink"
                   href="@loginTarget"
                   class="login-success-link">
                    Hemen devam et
                </a>
            </section>
        </div>
    }

    <script>
        (() => {
            const form = document.getElementById("loginForm");
            const email = document.getElementById("Email");
            const button = document.getElementById("loginButton");
            const buttonText = document.getElementById("loginButtonText");
            const spinner = document.getElementById("loginSpinner");

            const dialog = document.getElementById("loginSuccessDialog");
            const continueLink = document.getElementById("loginContinueLink");

            let isSubmitting = false;

            function resetButton() {
                isSubmitting = false;
                button.disabled = false;
                spinner.hidden = true;
                buttonText.textContent = "Giriş yap";
                form.removeAttribute("aria-busy");
            }

            form.addEventListener("submit", event => {
                if (isSubmitting) {
                    event.preventDefault();
                    return;
                }

                email.value = email.value.trim();

                if (!form.reportValidity()) {
                    event.preventDefault();
                    return;
                }

                isSubmitting = true;
                button.disabled = true;
                spinner.hidden = false;
                buttonText.textContent = "Kontrol ediliyor…";
                form.setAttribute("aria-busy", "true");

                // Normal MVC POST devam eder.
            });

            window.addEventListener("pageshow", resetButton);

            if (dialog && continueLink) {
                dialog.focus();

                // Hedef adres controller'da Url.IsLocalUrl ile kontrol edilir.
                // Adresi JavaScript içine metin olarak yerleştirmiyoruz.
                window.setTimeout(() => {
                    window.location.replace(continueLink.href);
                }, 1200);
            }
        })();
    </script>

</body>
</html>