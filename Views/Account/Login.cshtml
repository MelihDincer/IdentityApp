@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - IdentityApp</title>

    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>

<body class="auth-page">
    <main class="auth-shell">

        <div class="auth-brand">
            <span class="auth-brand-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.6"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 3 20 6v6c0 4-5 8-8 9-3-1-8-5-8-9V6l8-3Z" />
                    <path d="m8.5 12 2.5 2.5 4.5-5" />
                </svg>
            </span>

            <span>IdentityApp</span>
        </div>

        <div class="auth-panel">

            <aside class="auth-aside" aria-label="Hoş geldiniz">
                <div>
                    <span class="auth-eyebrow">Hesap erişimi</span>

                    <h2>Tekrar<br />hoş geldiniz.</h2>

                    <p>
                        Hesabınıza giriş yapın, çalışma alanınıza
                        kaldığınız yerden devam edin.
                    </p>
                </div>

                <div class="auth-aside-note">
                    Hesabınız ve çalışma alanınız, tek bir yerde.
                </div>
            </aside>

            <section class="auth-content" aria-labelledby="loginTitle">
                <header class="auth-heading">
                    <h1 id="loginTitle">Giriş yap</h1>
                    <p>Devam etmek için hesap bilgilerinizi girin.</p>
                </header>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="auth-form">

                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "auth-validation", role = "alert" })

                    <input type="hidden"
                           name="ReturnUrl"
                           value="@ViewData["ReturnUrl"]" />

                    <div class="auth-field">
                        <label for="Email" class="auth-label">
                            E-posta adresi
                        </label>

                        @Html.TextBox("Email", null, new
                        {
                            @class = "auth-input",
                            type = "email",
                            placeholder = "ornek@firma.com",
                            autocomplete = "username",
                            required = "required",
                            aria_describedby = "emailError"
                        })

                        @Html.ValidationMessage("Email", null, new
                        {
                            @class = "auth-error",
                            id = "emailError"
                        })
                    </div>

                    <div class="auth-field">
                        <label for="Password" class="auth-label">
                            Parola
                        </label>

                        <input id="Password"
                               name="Password"
                               type="password"
                               class="auth-input"
                               placeholder="Parolanızı girin"
                               autocomplete="current-password"
                               aria-describedby="passwordError"
                               required />

                        @Html.ValidationMessage("Password", null, new
                        {
                            @class = "auth-error",
                            id = "passwordError"
                        })
                    </div>

                    <label for="RememberMe" class="auth-checkbox">
                        @Html.CheckBox("RememberMe")
                        <span>Beni hatırla</span>
                    </label>

                    <button type="submit" class="auth-submit">
                        Giriş yap
                    </button>
                </form>

                <p class="auth-switch">
                    Henüz hesabınız yok mu?
                    <a asp-controller="Account" asp-action="Register">
                        Hesap oluştur
                    </a>
                </p>
            </section>

        </div>

        <footer class="auth-footer">
            © @DateTime.Now.Year IdentityApp
        </footer>

    </main>
</body>
</html>