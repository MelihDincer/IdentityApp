@model IdentityApp.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Parolamı unuttum";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - IdentityApp</title>

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body class="auth-page">
    <main class="auth-shell">

        <div class="auth-brand">
            <span class="auth-brand-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.6"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 3 20 6v6c0 4-5 8-8 9-3-1-8-5-8-9V6l8-3Z" />
                    <path d="m8.5 12 2.5 2.5 4.5-5" />
                </svg>
            </span>

            <span>IdentityApp</span>
        </div>

        <div class="auth-panel">

            <aside class="auth-aside" aria-label="Parola sıfırlama">
                <div>
                    <span class="auth-eyebrow">Hesap güvenliği</span>

                    <h2>Hesabınıza yeniden<br />erişin.</h2>

                    <p>
                        Parolanızı unuttuysanız e-posta adresinize
                        gönderilen bağlantıyla yeni bir parola
                        belirleyebilirsiniz.
                    </p>
                </div>

                <div class="auth-aside-note">
                    Parolanızı ve sıfırlama bağlantınızı kimseyle paylaşmayın.
                </div>
            </aside>

            <section class="auth-content" aria-labelledby="pageTitle">

                <header class="auth-heading">
                    <h1 id="pageTitle">Parolamı unuttum</h1>
                    <p>
                        Sıfırlama bağlantısı istemek için hesabınıza
                        ait e-posta adresini yazın.
                    </p>
                </header>

                <form asp-controller="Account"
                      asp-action="ForgotPassword"
                      method="post"
                      class="auth-form">

                    <div asp-validation-summary="ModelOnly"
                         class="auth-validation"
                         role="alert">
                    </div>

                    <div class="auth-field">
                        <label asp-for="Email" class="auth-label">
                            E-posta adresi
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="auth-input"
                               placeholder="ornek@firma.com"
                               autocomplete="email"
                               aria-describedby="emailHint emailError"
                               required />

                        <small id="emailHint" class="auth-hint">
                            Hesabınızı oluştururken kullandığınız adresi girin.
                        </small>

                        <span asp-validation-for="Email"
                              id="emailError"
                              class="auth-error">
                        </span>
                    </div>

                    <button type="submit" class="auth-submit">
                        Sıfırlama bağlantısı gönder
                    </button>
                </form>

                <p class="auth-switch">
                    Parolanızı hatırladınız mı?
                    <a asp-controller="Account" asp-action="Login">
                        Giriş yap
                    </a>
                </p>

            </section>
        </div>

        <footer class="auth-footer">
            © @DateTime.Now.Year IdentityApp
        </footer>

    </main>
</body>
</html>