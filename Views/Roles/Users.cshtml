@model RoleUsersViewModel

@{
    ViewData["Title"] = $"{Model.DisplayName} - Kullanıcılar";

    var firstRecord = Model.FilteredUserCount == 0
        ? 0
        : (Model.CurrentPage - 1) * Model.PageSize + 1;

    var lastRecord = Model.FilteredUserCount == 0
        ? 0
        : firstRecord + Model.Users.Count - 1;

    var startPage = Math.Max(1, Model.CurrentPage - 2);
    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
}

<link rel="stylesheet" href="~/css/role.css" asp-append-version="true" />

<div class="container-fluid py-4">
    <div class="roles-page">

        <a asp-controller="Roles"
           asp-action="Index"
           class="roles-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Rollere Dön
        </a>

        <div class="roles-header">
            <div>
                <div class="ru-heading">
                    <h1 class="roles-title">@Model.DisplayName</h1>

                    <span class="ru-status @(Model.IsActive
                        ? "ru-status-active"
                        : "ru-status-inactive")">

                        <i class="bi @(Model.IsActive
                            ? "bi-check-circle"
                            : "bi-pause-circle")"
                           aria-hidden="true"></i>

                        @(Model.IsActive ? "Aktif" : "Pasif")
                    </span>
                </div>

                <p class="roles-description">
                    Bu role atanmış kullanıcıları görüntüleyin.
                </p>

                <div class="ru-role-meta">
                    <span>@Model.RoleName</span>

                    @if (Model.IsSystemRole)
                    {
                        <span>
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            Sistem Rolü
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- ROL İÇİ GEZİNME -->
        <nav class="ru-tabs" aria-label="Rol bölümleri">
            <a asp-controller="Roles"
               asp-action="Edit"
               asp-route-id="@Model.RoleId"
               class="ru-tab">

                <i class="bi bi-sliders" aria-hidden="true"></i>
                Genel Bilgiler
            </a>

            <a asp-controller="Roles"
               asp-action="Users"
               asp-route-id="@Model.RoleId"
               class="ru-tab ru-tab-active"
               aria-current="page">

                <i class="bi bi-people" aria-hidden="true"></i>
                Kullanıcılar
                <span class="ru-tab-count">@Model.TotalUserCount</span>
            </a>
        </nav>

        <div class="roles-card">

            <div class="roles-card-header">
                <span class="roles-icon">
                    <i class="bi bi-people" aria-hidden="true"></i>
                </span>

                <div>
                    <h2 class="roles-card-title">Atanmış Kullanıcılar</h2>

                    <div class="roles-help">
                        Bu role toplam
                        <strong>@Model.TotalUserCount</strong>
                        kullanıcı atanmış.
                    </div>
                </div>
            </div>

            <!-- ARAMA -->
            <div class="ru-toolbar">
                <form asp-controller="Roles"
                      asp-action="Users"
                      method="get"
                      class="ru-search-form">

                    <input type="hidden"
                           name="id"
                           value="@Model.RoleId" />

                    <div class="ru-search-input">
                        <i class="bi bi-search" aria-hidden="true"></i>

                        <label for="roleUserSearch" class="visually-hidden">
                            Role atanmış kullanıcıları ara
                        </label>

                        <input id="roleUserSearch"
                               type="search"
                               name="search"
                               value="@Model.Search"
                               placeholder="Ad, kullanıcı adı, e-posta veya telefon ara..."
                               autocomplete="off" />
                    </div>

                    <button type="submit" class="roles-button">
                        Ara
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-controller="Roles"
                           asp-action="Users"
                           asp-route-id="@Model.RoleId"
                           class="roles-button roles-button-secondary">
                            Temizle
                        </a>
                    }
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <div class="ru-search-result">
                        <strong>@Model.FilteredUserCount</strong>
                        kullanıcı bulundu.
                    </div>
                }
            </div>

            @if (Model.Users.Count > 0)
            {
                <div class="table-responsive">
                    <table class="roles-table ru-users-table">
                        <thead>
                            <tr>
                                <th scope="col">Kullanıcı</th>
                                <th scope="col">E-posta</th>
                                <th scope="col">Telefon</th>
                                <th scope="col" class="text-end">İşlem</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                var displayName =
                                    !string.IsNullOrWhiteSpace(user.FullName)
                                        ? user.FullName
                                        : !string.IsNullOrWhiteSpace(user.UserName)
                                            ? user.UserName
                                            : "İsimsiz Kullanıcı";

                                <tr>
                                    <td>
                                        <div class="ru-user">
                                            <div class="ru-avatar">
                                                <i class="bi bi-person"
                                                   aria-hidden="true"></i>
                                            </div>

                                            <div>
                                                <div class="ru-user-name">
                                                    @displayName
                                                </div>

                                                <div class="ru-user-secondary">
                                                    @user.UserName
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="ru-contact">
                                            @(string.IsNullOrWhiteSpace(user.Email)
                                                ? "—"
                                                : user.Email)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="ru-contact">
                                            @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                                ? "—"
                                                : user.PhoneNumber)
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Users"
                                           asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="ru-edit-link"
                                           aria-label="@(displayName + " kullanıcısını düzenle")">

                                            <i class="bi bi-pencil"
                                               aria-hidden="true"></i>
                                            Düzenle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="roles-empty">
                    <i class="bi bi-people fs-2 d-block mb-3"
                       aria-hidden="true"></i>

                    @if (Model.TotalUserCount == 0)
                    {
                        <strong>Bu role atanmış kullanıcı bulunmuyor.</strong>

                        <div class="mt-2">
                            Kullanıcı oluşturma veya düzenleme ekranından
                            rol atayabilirsiniz.
                        </div>
                    }
                    else
                    {
                        <strong>Aramanızla eşleşen kullanıcı bulunamadı.</strong>

                        <div class="mt-2">
                            Farklı bir arama yapabilir veya filtreyi temizleyebilirsiniz.
                        </div>
                    }
                </div>
            }

            <!-- SAYFALAMA -->
            @if (Model.FilteredUserCount > 0)
            {
                <div class="ru-pagination">
                    <span class="ru-range">
                        @Model.FilteredUserCount sonuçtan
                        @firstRecord–@lastRecord gösteriliyor
                    </span>

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="ru-page-links"
                             aria-label="Kullanıcı listesi sayfaları">

                            @if (Model.CurrentPage > 1)
                            {
                                <a asp-controller="Roles"
                                   asp-action="Users"
                                   asp-route-id="@Model.RoleId"
                                   asp-route-search="@Model.Search"
                                   asp-route-pageNumber="@(Model.CurrentPage - 1)"
                                   class="ru-page-link"
                                   aria-label="Önceki sayfa">

                                    <i class="bi bi-chevron-left"
                                       aria-hidden="true"></i>
                                </a>
                            }

                            @for (var page = startPage; page <= endPage; page++)
                            {
                                if (page == Model.CurrentPage)
                                {
                                    <span class="ru-page-link ru-page-current"
                                          aria-current="page"
                                          aria-label="@($"Sayfa {page}")">
                                        @@page
                                    </span>
                                }
                                else
                                {
                                    <a asp-controller="Roles"
                                       asp-action="Users"
                                       asp-route-id="@Model.RoleId"
                                       asp-route-search="@Model.Search"
                                       asp-route-pageNumber="@@page"
                                       class="ru-page-link"
                                       aria-label="@($"Sayfa {page}")">
                                        @@page
                                    </a>
                                }
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a asp-controller="Roles"
                                   asp-action="Users"
                                   asp-route-id="@Model.RoleId"
                                   asp-route-search="@Model.Search"
                                   asp-route-pageNumber="@(Model.CurrentPage + 1)"
                                   class="ru-page-link"
                                   aria-label="Sonraki sayfa">

                                    <i class="bi bi-chevron-right"
                                       aria-hidden="true"></i>
                                </a>
                            }
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>